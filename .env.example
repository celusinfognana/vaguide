# Property Support Hub - Configuration

# This file documents the configuration available for the application.
# Currently, all features are mock/local with no backend integration.

# API Configuration (for future use)
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_SEARCH=true
VITE_ENABLE_FAVORITES=true
VITE_ENABLE_RECENT=true
VITE_ENABLE_NOTIFICATIONS=true

# App Settings
VITE_APP_NAME=Property Support Hub
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Mock Data
VITE_USE_MOCK_DATA=true
VITE_MOCK_PROPERTIES_COUNT=12
VITE_MOCK_PROCEDURES_PER_PROPERTY=20

# UI Settings
VITE_ITEMS_PER_PAGE=20
VITE_TOAST_DURATION=3000
VITE_SEARCH_DEBOUNCE=300
